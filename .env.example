# Select "ollama" (default) or "gemini".
AI_PROVIDER=ollama
# Ollama server URL for local use.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Ollama model for local use.
OLLAMA_MODEL=llama3.2
# Gemini API key; required only when AI_PROVIDER=gemini.
GEMINI_API_KEY=
# Gemini model to use.
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated Gemini models to try when the primary model is rate limited.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
# Public, non-secret footer label: "Ollama (local)" or "Gemini".
NEXT_PUBLIC_AI_PROVIDER_LABEL="Ollama (local)"
